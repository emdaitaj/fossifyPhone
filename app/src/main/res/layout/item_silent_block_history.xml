<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/silent_block_history_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingTop="@dimen/medium_margin"
    android:paddingBottom="@dimen/medium_margin">

    <ImageView
        android:id="@+id/silent_block_history_icon"
        android:layout_width="@dimen/normal_icon_size"
        android:layout_height="@dimen/normal_icon_size"
        android:layout_marginStart="@dimen/normal_margin"
        android:importantForAccessibility="no"
        android:padding="@dimen/small_margin"
        android:src="@drawable/ic_block_vector"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/silent_block_history_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/medium_margin"
        android:layout_marginEnd="@dimen/activity_margin"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textDirection="firstStrongLtr"
        android:textSize="@dimen/bigger_text_size"
        app:layout_constraintBottom_toTopOf="@+id/silent_block_history_details"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/silent_block_history_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="John Doe" />

    <TextView
        android:id="@+id/silent_block_history_details"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:alpha="0.7"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textSize="@dimen/normal_text_size"
        app:layout_constraintBottom_toTopOf="@+id/silent_block_history_date"
        app:layout_constraintEnd_toEndOf="@+id/silent_block_history_name"
        app:layout_constraintStart_toStartOf="@+id/silent_block_history_name"
        app:layout_constraintTop_toBottomOf="@+id/silent_block_history_name"
        tools:text="+1 234 567 8900 • Group list" />

    <TextView
        android:id="@+id/silent_block_history_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:alpha="0.7"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textSize="@dimen/smaller_text_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/silent_block_history_name"
        app:layout_constraintStart_toStartOf="@+id/silent_block_history_name"
        app:layout_constraintTop_toBottomOf="@+id/silent_block_history_details"
        tools:text="4 July, 04:37 PM" />

</androidx.constraintlayout.widget.ConstraintLayout>
